{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "noEmit": true,
    "noImplicitAny": true,
    "strict": true,
    "types": [],
    "typeRoots": ["./node_modules/@types", "./typings"],
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "nativewind-env.d.ts"],
  "exclude": ["node_modules", "supabase/functions"]
}
