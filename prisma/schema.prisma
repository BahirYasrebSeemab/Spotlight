// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

// -----------------------------
//  SPOTLIGHT MAIN SCHEMA
// -----------------------------

model User {
  id        String    @id
  username  String    @unique
  email     String    @unique
  name      String?
  bio       String?
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  dob       DateTime?

  // Relations
  closets    Closet[]
  ownerships Ownership[]
  posts      Post[]
  matches    Match[]
  followers  Follower[]  @relation("UserFollowers")
  following  Follower[]  @relation("UserFollowing")

  // Cached counts (denormalized)
  followersCount     Int       @default(0)
  followingCount     Int       @default(0)
  postsCount         Int       @default(0)
  ownershipsCount    Int       @default(0)
  internationalCount Int       @default(0)
  localCount         Int       @default(0)
  tailoredCount      Int       @default(0)
  Like               Like[]
  Comment            Comment[]
}

model Brand {
  id          String    @id @default(dbgenerated("uuid_generate_v4()"))
  name        String    @unique
  description String?
  logoUrl     String?
  verified    Boolean   @default(false)
  type        BrandType @default(LOCAL)
  createdAt   DateTime  @default(now())

  products Product[]
}

enum BrandType {
  INTERNATIONAL
  LOCAL
  TAILORED
}

model Product {
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  brandId   String?
  brand     Brand?   @relation(fields: [brandId], references: [id])
  name      String
  upc       String?  @unique
  imageUrl  String?
  category  String?
  createdAt DateTime @default(now())

  ownerships Ownership[]
}

model Ownership {
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  status    String   @default("owned") // owned | transferred | pending
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  closetItems ClosetItem[]
  postItems   PostItem[]
  MatchItem   MatchItem[]
}

model Closet {
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  name      String
  createdAt DateTime @default(now())

  items ClosetItem[]
}

model ClosetItem {
  id          String    @id @default(dbgenerated("uuid_generate_v4()"))
  closetId    String
  closet      Closet    @relation(fields: [closetId], references: [id])
  ownershipId String
  ownership   Ownership @relation(fields: [ownershipId], references: [id])
  createdAt   DateTime  @default(now())
}

model Post {
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  caption   String?
  mediaUrl  String?
  createdAt DateTime @default(now())

  items    PostItem[]
  likes    Like[]
  comments Comment[]

  // Cached count fields
  likesCount    Int @default(0)
  commentsCount Int @default(0)
}

model PostItem {
  id          String    @id @default(dbgenerated("uuid_generate_v4()"))
  postId      String
  post        Post      @relation(fields: [postId], references: [id])
  ownershipId String
  ownership   Ownership @relation(fields: [ownershipId], references: [id])
}

model Like {
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model Match {
  id        String   @id @default(dbgenerated("uuid_generate_v4()"))
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String?
  createdAt DateTime @default(now())

  items MatchItem[]
}

model MatchItem {
  id          String    @id @default(dbgenerated("uuid_generate_v4()"))
  matchId     String
  match       Match     @relation(fields: [matchId], references: [id])
  ownershipId String
  ownership   Ownership @relation(fields: [ownershipId], references: [id])
}

model Follower {
  id          String   @id @default(dbgenerated("uuid_generate_v4()"))
  followerId  String
  followingId String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id])
  following   User     @relation("UserFollowers", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())
}
