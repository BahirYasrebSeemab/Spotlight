generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

model User {
  username                                      String          @unique
  email                                         String          @unique
  avatarUrl                                     String          @default("https://djmiacrhlrehonnuflhi.supabase.co/storage/v1/object/public/static/general/default.jpg")
  bio                                           String?
  createdAt                                     DateTime        @default(now())
  followersCount                                Int             @default(0)
  followingCount                                Int             @default(0)
  internationalCount                            Int             @default(0)
  localCount                                    Int             @default(0)
  name                                          String?
  ownershipsCount                               Int             @default(0)
  postsCount                                    Int             @default(0)
  tailoredCount                                 Int             @default(0)
  updatedAt                                     DateTime        @default(now()) @updatedAt
  dob                                           DateTime?       @default(dbgenerated("'1970-01-01 00:00:00'::timestamp without time zone"))
  emailConfirmedAt                              DateTime?
  lastLoginAt                                   DateTime?
  id                                            String          @id @db.Uuid
  isPrivate                                     Boolean?        @default(false)
  closets                                       Closet[]
  Comment                                       Comment[]
  FollowRequest_FollowRequest_requestedIdToUser FollowRequest[] @relation("FollowRequest_requestedIdToUser")
  FollowRequest_FollowRequest_requesterIdToUser FollowRequest[] @relation("FollowRequest_requesterIdToUser")
  Follower_Follower_followerIdToUser            Follower[]      @relation("Follower_followerIdToUser")
  Follower_Follower_followingIdToUser           Follower[]      @relation("Follower_followingIdToUser")
  Like                                          Like[]
  matches                                       Match[]
  ownerships                                    Ownership[]
  posts                                         Post[]
}

model Brand {
  name        String    @unique
  description String?
  logoUrl     String?
  verified    Boolean   @default(false)
  type        BrandType @default(LOCAL)
  createdAt   DateTime  @default(now())
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  products    Product[]
}

model Product {
  name       String
  upc        String?     @unique
  imageUrl   String?
  category   String?
  createdAt  DateTime    @default(now())
  id         String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  brandId    String?     @db.Uuid
  ownerships Ownership[]
  brand      Brand?      @relation(fields: [brandId], references: [id])
}

model Ownership {
  status      String       @default("owned")
  verified    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  id          String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ownerId     String       @db.Uuid
  productId   String       @db.Uuid
  closetItems ClosetItem[]
  MatchItem   MatchItem[]
  owner       User         @relation(fields: [ownerId], references: [id])
  product     Product      @relation(fields: [productId], references: [id])
  postItems   PostItem[]
}

model Closet {
  name      String
  createdAt DateTime     @default(now())
  id        String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ownerId   String       @db.Uuid
  owner     User         @relation(fields: [ownerId], references: [id])
  items     ClosetItem[]
}

model ClosetItem {
  createdAt   DateTime  @default(now())
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  closetId    String    @db.Uuid
  ownershipId String    @db.Uuid
  closet      Closet    @relation(fields: [closetId], references: [id])
  ownership   Ownership @relation(fields: [ownershipId], references: [id])
}

model Post {
  caption       String?
  mediaUrl      String?
  createdAt     DateTime   @default(now())
  likesCount    Int        @default(0)
  commentsCount Int        @default(0)
  id            String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  authorId      String     @db.Uuid
  comments      Comment[]
  likes         Like[]
  author        User       @relation(fields: [authorId], references: [id])
  items         PostItem[]
}

model PostItem {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  postId      String    @db.Uuid
  ownershipId String    @db.Uuid
  ownership   Ownership @relation(fields: [ownershipId], references: [id])
  post        Post      @relation(fields: [postId], references: [id])
}

model Like {
  createdAt DateTime @default(now())
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Comment {
  content   String
  createdAt DateTime @default(now())
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Match {
  title     String?
  createdAt DateTime    @default(now())
  id        String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id])
  items     MatchItem[]
}

model MatchItem {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  matchId     String    @db.Uuid
  ownershipId String    @db.Uuid
  match       Match     @relation(fields: [matchId], references: [id])
  ownership   Ownership @relation(fields: [ownershipId], references: [id])
}

model Follower {
  createdAt                       DateTime @default(now())
  id                              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  followerId                      String   @db.Uuid
  followingId                     String   @db.Uuid
  User_Follower_followerIdToUser  User     @relation("Follower_followerIdToUser", fields: [followerId], references: [id])
  User_Follower_followingIdToUser User     @relation("Follower_followingIdToUser", fields: [followingId], references: [id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model FollowRequest {
  id                                   String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  requesterId                          String   @db.Uuid
  requestedId                          String   @db.Uuid
  status                               String   @default("pending")
  createdAt                            DateTime @default(now()) @db.Timestamp(6)
  updatedAt                            DateTime @default(now()) @db.Timestamp(6)
  User_FollowRequest_requestedIdToUser User     @relation("FollowRequest_requestedIdToUser", fields: [requestedId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User_FollowRequest_requesterIdToUser User     @relation("FollowRequest_requesterIdToUser", fields: [requesterId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([requesterId, requestedId])
  @@index([requestedId], map: "idx_follow_request_requested")
  @@index([requesterId], map: "idx_follow_request_requester")
  @@index([status], map: "idx_follow_request_status")
}

enum BrandType {
  INTERNATIONAL
  LOCAL
  TAILORED
}
