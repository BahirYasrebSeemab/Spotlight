generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

// -----------------------------
// SPOTLIGHT MAIN SCHEMA
// -----------------------------

model User {
  id               String    @id @db.Uuid // This will match Supabase auth UID
  username         String    @unique
  email            String    @unique
  name             String?
  bio              String?
  avatarUrl        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  dob              DateTime? @default("1970-01-01T00:00:00.000Z")
  lastLoginAt      DateTime?
  emailConfirmedAt DateTime?

  // Relations
  closets    Closet[]
  ownerships Ownership[]
  posts      Post[]
  matches    Match[]
  followers  Follower[]  @relation("UserFollowers")
  following  Follower[]  @relation("UserFollowing")
  Like       Like[]
  Comment    Comment[]

  // Cached counts
  followersCount     Int @default(0)
  followingCount     Int @default(0)
  postsCount         Int @default(0)
  ownershipsCount    Int @default(0)
  internationalCount Int @default(0)
  localCount         Int @default(0)
  tailoredCount      Int @default(0)
}

model Brand {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String    @unique
  description String?
  logoUrl     String?
  verified    Boolean   @default(false)
  type        BrandType @default(LOCAL)
  createdAt   DateTime  @default(now())

  products Product[]
}

enum BrandType {
  INTERNATIONAL
  LOCAL
  TAILORED
}

model Product {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  brandId   String?  @db.Uuid
  brand     Brand?   @relation(fields: [brandId], references: [id])
  name      String
  upc       String?  @unique
  imageUrl  String?
  category  String?
  createdAt DateTime @default(now())

  ownerships Ownership[]
}

model Ownership {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ownerId   String   @db.Uuid
  owner     User     @relation(fields: [ownerId], references: [id])
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id])
  status    String   @default("owned")
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  closetItems ClosetItem[]
  postItems   PostItem[]
  MatchItem   MatchItem[]
}

model Closet {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ownerId   String   @db.Uuid
  owner     User     @relation(fields: [ownerId], references: [id])
  name      String
  createdAt DateTime @default(now())

  items ClosetItem[]
}

model ClosetItem {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  closetId    String    @db.Uuid
  closet      Closet    @relation(fields: [closetId], references: [id])
  ownershipId String    @db.Uuid
  ownership   Ownership @relation(fields: [ownershipId], references: [id])
  createdAt   DateTime  @default(now())
}

model Post {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  authorId  String   @db.Uuid
  author    User     @relation(fields: [authorId], references: [id])
  caption   String?
  mediaUrl  String?
  createdAt DateTime @default(now())

  items    PostItem[]
  likes    Like[]
  comments Comment[]

  likesCount    Int @default(0)
  commentsCount Int @default(0)
}

model PostItem {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  postId      String    @db.Uuid
  post        Post      @relation(fields: [postId], references: [id])
  ownershipId String    @db.Uuid
  ownership   Ownership @relation(fields: [ownershipId], references: [id])
}

model Like {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  postId    String   @db.Uuid
  post      Post     @relation(fields: [postId], references: [id])
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  postId    String   @db.Uuid
  post      Post     @relation(fields: [postId], references: [id])
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model Match {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  title     String?
  createdAt DateTime @default(now())

  items MatchItem[]
}

model MatchItem {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  matchId     String    @db.Uuid
  match       Match     @relation(fields: [matchId], references: [id])
  ownershipId String    @db.Uuid
  ownership   Ownership @relation(fields: [ownershipId], references: [id])
}

model Follower {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String   @db.Uuid // the person being followed
  follower_id  String   @db.Uuid // the person who follows
  createdAt    DateTime @default(now())

  @@unique([user_id, follower_id])
  @@index([user_id])
  @@index([follower_id])
}
