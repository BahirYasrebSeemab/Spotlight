generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

model User {
  isActive                 Boolean             @default(true)
  username                 String              @unique
  email                    String              @unique
  avatarUrl                String              @default("https://djmiacrhlrehonnuflhi.supabase.co/storage/v1/object/public/static/general/default.jpg")
  bio                      String?
  createdAt                DateTime            @default(now())
  followersCount           Int                 @default(0)
  followingCount           Int                 @default(0)
  internationalCount       Int                 @default(0)
  localCount               Int                 @default(0)
  name                     String?
  ownershipsCount          Int                 @default(0)
  tailoredCount            Int                 @default(0)
  updatedAt                DateTime            @default(now()) @updatedAt
  dob                      DateTime?           @default(dbgenerated("'1970-01-01 00:00:00'::timestamp without time zone"))
  emailConfirmedAt         DateTime?
  lastLoginAt              DateTime?
  id                       String              @id @db.Uuid
  isPrivate                Boolean?            @default(false)
  memoriesCount            Int                 @default(0)
  brandAdmins              BrandAdmin[]
  BrandFollower            BrandFollower[]
  closets                  Closet[]
  comments                 Comment[]
  communityProductsCreated CommunityProduct[]  @relation("CommunityProductCreator")
  followRequests_received  FollowRequest[]     @relation("FollowRequest_requestedIdToUser")
  followRequests_sent      FollowRequest[]     @relation("FollowRequest_requesterIdToUser")
  followers                Follower[]          @relation("Follower_followerIdToUser")
  following                Follower[]          @relation("Follower_followingIdToUser")
  likes                    Like[]
  matches                  Match[]
  memories                 Memory[]
  ownerships               Ownership[]
  receivedTransfers        OwnershipTransfer[] @relation("TransferReceiver")

  @@index([email])
  @@index([username])
}
  
model Follower {
  createdAt   DateTime @default(now())
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  follower    User     @relation("Follower_followerIdToUser", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Follower_followingIdToUser", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model FollowRequest {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  requesterId String   @db.Uuid
  requestedId String   @db.Uuid
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @db.Timestamp(6)
  requested   User     @relation("FollowRequest_requestedIdToUser", fields: [requestedId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  requester   User     @relation("FollowRequest_requesterIdToUser", fields: [requesterId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([requesterId, requestedId])
  @@index([requestedId], map: "idx_follow_request_requested")
  @@index([requesterId], map: "idx_follow_request_requester")
  @@index([status], map: "idx_follow_request_status")
}

model Brand {
  name              String              @unique
  description       String?
  logoUrl           String?
  verified          Boolean             @default(false)
  type              BrandType           @default(LOCAL)
  createdAt         DateTime            @default(now())
  id                String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  updatedAt         DateTime            @default(now()) @updatedAt
  applicationStatus String              @default("pending")
  appliedAt         DateTime?
  approvedAt        DateTime?
  approvedBy        String?             @db.Uuid
  contractEndDate   DateTime?
  contractStartDate DateTime?
  contractTier      String?
  rejectionReason   String?
  transferQuota     Int                 @default(0)
  transfersUsed     Int                 @default(0)
  followersCount    Int?                @default(0) @db.SmallInt
  website           String?
  instagram         String?
  contactEmail      String?
  applicationReason String?
  brandAdmins       BrandAdmin[]
  BrandFollower     BrandFollower[]
  claimedProducts   CommunityProduct[]  @relation("BrandClaimedProducts")
  transfers         OwnershipTransfer[]
  prototypes        Prototype[]

  @@index([name])
  @@index([verified])
  @@index([type])
  @@index([applicationStatus])
}

model BrandAdmin {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @db.Uuid
  brandId   String   @db.Uuid
  role      String   @default("admin")
  createdAt DateTime @default(now())
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, brandId])
  @@index([userId])
  @@index([brandId])
}

model Prototype {
  id                             String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                           String
  description                    String?
  brandId                        String              @db.Uuid
  sku                            String?             @unique
  upc                            String?
  category                       String?
  retailPrice                    Decimal?            @db.Decimal(10, 2)
  imageUrl                       String?
  thumbnailUrl                   String?
  variants                       Json?
  isVerified                     Boolean             @default(true)
  verifiedAt                     DateTime            @default(now())
  verifiedBy                     String?             @db.Uuid
  isActive                       Boolean             @default(true)
  createdAt                      DateTime            @default(now())
  updatedAt                      DateTime            @default(now()) @updatedAt
  migratedFromCommunityProductId String?             @db.Uuid
  ownerships                     Ownership[]
  transfers                      OwnershipTransfer[]
  brand                          Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([sku])
  @@index([upc])
  @@index([category])
  @@index([isActive])
  @@index([name])
}

model CommunityProduct {
  id                    String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                  String
  brandName             String
  description           String?
  upc                   String?
  category              String?
  imageUrl              String?
  thumbnailUrl          String?
  createdBy             String                 @db.Uuid
  status                CommunityProductStatus @default(ACTIVE)
  migratedToPrototypeId String?                @db.Uuid
  ownershipCount        Int                    @default(0)
  flagCount             Int                    @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @default(now()) @updatedAt
  brandNotified         Boolean                @default(false)
  claimedAt             DateTime?
  claimedByBrandId      String?                @db.Uuid
  claimedByBrand        Brand?                 @relation("BrandClaimedProducts", fields: [claimedByBrandId], references: [id])
  creator               User                   @relation("CommunityProductCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  ownerships            Ownership[]

  @@index([brandName])
  @@index([upc])
  @@index([status])
  @@index([createdBy])
  @@index([claimedByBrandId])
  @@index([name])
}

model Ownership {
  status             String             @default("owned")
  verified           Boolean            @default(false)
  createdAt          DateTime           @default(now())
  id                 String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ownerId            String             @db.Uuid
  communityProductId String?            @db.Uuid
  condition          String?
  isAuthenticated    Boolean            @default(false)
  notes              String?
  originalImageUrl   String?
  ownershipChain     Json?
  processedImageUrl  String?
  processingStatus   String             @default("completed")
  prototypeId        String?            @db.Uuid
  purchaseDate       DateTime?
  purchasePrice      Decimal?           @db.Decimal(10, 2)
  selectedVariant    Json?
  serialNumber       String?            @unique
  thumbnailUrl       String?
  transferable       Boolean            @default(false)
  updatedAt          DateTime           @default(now()) @updatedAt
  flagReason         String?
  flagged            Boolean            @default(false)
  flaggedAt          DateTime?
  flaggedBy          String?            @db.Uuid
  transferId         String?            @db.Uuid
  useOfficialImage   Boolean            @default(true)
  verificationCode   String?            @unique
  verifiedAt         DateTime?
  verifiedBy         String?            @db.Uuid
  thumbnailImageUrl  String?
  closetItems        ClosetItem[]
  matchItems         MatchItem[]
  memoryItems        MemoryItem[]
  communityProduct   CommunityProduct?  @relation(fields: [communityProductId], references: [id])
  owner              User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  prototype          Prototype?         @relation(fields: [prototypeId], references: [id])
  transfer           OwnershipTransfer? @relation(fields: [transferId], references: [id])

  @@unique([ownerId, prototypeId, serialNumber])
  @@index([ownerId])
  @@index([prototypeId])
  @@index([communityProductId])
  @@index([serialNumber])
  @@index([status])
  @@index([processingStatus])
  @@index([verified])
  @@index([flagged])
}

model OwnershipTransfer {
  id               String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  brandId          String      @db.Uuid
  prototypeId      String      @db.Uuid
  recipientId      String      @db.Uuid
  transferredBy    String      @db.Uuid
  transferredAt    DateTime    @default(now())
  verificationCode String      @unique
  purchaseOrderId  String?
  notes            String?
  status           String      @default("completed")
  ownerships       Ownership[]
  brand            Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  prototype        Prototype   @relation(fields: [prototypeId], references: [id], onDelete: Cascade)
  recipient        User        @relation("TransferReceiver", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([prototypeId])
  @@index([recipientId])
  @@index([transferredAt])
  @@index([status])
}

model Memory {
  id            String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId        String       @db.Uuid
  title         String?
  caption       String?
  mediaUrl      String
  mediaType     String
  thumbnailUrl  String?
  takenAt       DateTime?
  location      String?
  likesCount    Int          @default(0)
  commentsCount Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  comments      Comment[]
  likes         Like[]
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         MemoryItem[]

  @@index([userId])
  @@index([createdAt])
  @@index([mediaType])
}

model MemoryItem {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  memoryId    String    @db.Uuid
  ownershipId String    @db.Uuid
  memory      Memory    @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  ownership   Ownership @relation(fields: [ownershipId], references: [id], onDelete: Cascade)

  @@unique([memoryId, ownershipId])
  @@index([memoryId])
  @@index([ownershipId])
}

model Closet {
  name      String
  createdAt DateTime     @default(now())
  id        String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ownerId   String       @db.Uuid
  updatedAt DateTime     @default(now()) @updatedAt
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items     ClosetItem[]

  @@index([ownerId])
}

model ClosetItem {
  createdAt   DateTime  @default(now())
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  closetId    String    @db.Uuid
  ownershipId String    @db.Uuid
  closet      Closet    @relation(fields: [closetId], references: [id], onDelete: Cascade)
  ownership   Ownership @relation(fields: [ownershipId], references: [id], onDelete: Cascade)

  @@unique([closetId, ownershipId])
  @@index([closetId])
  @@index([ownershipId])
}

model Like {
  createdAt DateTime @default(now())
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @db.Uuid
  memoryId  String   @db.Uuid
  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([memoryId, userId])
  @@index([memoryId])
  @@index([userId])
}

model Comment {
  content   String
  createdAt DateTime @default(now())
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt
  memoryId  String   @db.Uuid
  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@index([userId])
}

model Match {
  title     String?
  createdAt DateTime    @default(now())
  id        String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String      @db.Uuid
  updatedAt DateTime    @default(now()) @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     MatchItem[]

  @@index([userId])
}

model MatchItem {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  matchId     String    @db.Uuid
  ownershipId String    @db.Uuid
  match       Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  ownership   Ownership @relation(fields: [ownershipId], references: [id], onDelete: Cascade)

  @@unique([matchId, ownershipId])
  @@index([matchId])
  @@index([ownershipId])
}

model BrandFollower {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @db.Uuid
  brandId   String   @db.Uuid
  createdAt DateTime @default(now())
  Brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, brandId], map: "BrandFollower_userId_brandId_unique")
  @@index([brandId])
  @@index([userId])
}

enum BrandType {
  INTERNATIONAL
  LOCAL
  TAILORED
}

enum CommunityProductStatus {
  ACTIVE
  UNDER_REVIEW
  MIGRATED
  DELETED
  FLAGGED
}
