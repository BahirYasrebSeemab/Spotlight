generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

model User {
  username                 String             @unique
  email                    String             @unique
  avatarUrl                String             @default("https://djmiacrhlrehonnuflhi.supabase.co/storage/v1/object/public/static/general/default.jpg")
  bio                      String?
  createdAt                DateTime           @default(now())
  followersCount           Int                @default(0)
  followingCount           Int                @default(0)
  internationalCount       Int                @default(0)
  localCount               Int                @default(0)
  name                     String?
  ownershipsCount          Int                @default(0)
  memoriesCount            Int                @default(0)
  tailoredCount            Int                @default(0)
  updatedAt                DateTime           @default(now()) @updatedAt
  dob                      DateTime?          @default(dbgenerated("'1970-01-01 00:00:00'::timestamp without time zone"))
  emailConfirmedAt         DateTime?
  lastLoginAt              DateTime?
  id                       String             @id @db.Uuid
  isPrivate                Boolean?           @default(false)
  brandAdmins              BrandAdmin[]
  closets                  Closet[]
  comments                 Comment[]
  communityProductsCreated CommunityProduct[] @relation("CommunityProductCreator")
  followRequests_received  FollowRequest[]    @relation("FollowRequest_requestedIdToUser")
  followRequests_sent      FollowRequest[]    @relation("FollowRequest_requesterIdToUser")
  followers                Follower[]         @relation("Follower_followerIdToUser")
  following                Follower[]         @relation("Follower_followingIdToUser")
  likes                    Like[]
  matches                  Match[]
  memories                 Memory[]
  ownerships               Ownership[]
  receivedTransfers        OwnershipTransfer[] @relation("TransferReceiver")

  @@index([email])
  @@index([username])
}

model Follower {
  createdAt   DateTime @default(now())
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  follower    User     @relation("Follower_followerIdToUser", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Follower_followingIdToUser", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model FollowRequest {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  requesterId String   @db.Uuid
  requestedId String   @db.Uuid
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @db.Timestamp(6)
  requested   User     @relation("FollowRequest_requestedIdToUser", fields: [requestedId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  requester   User     @relation("FollowRequest_requesterIdToUser", fields: [requesterId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([requesterId, requestedId])
  @@index([requestedId], map: "idx_follow_request_requested")
  @@index([requesterId], map: "idx_follow_request_requester")
  @@index([status], map: "idx_follow_request_status")
}

model Brand {
  name              String              @unique
  description       String?
  logoUrl           String?
  verified          Boolean             @default(false)
  type              BrandType           @default(LOCAL)
  createdAt         DateTime            @default(now())
  id                String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  updatedAt         DateTime            @default(now()) @updatedAt
  
  // Transfer quota system (based on contract/package)
  transferQuota     Int                 @default(0)  // Total transfers allowed
  transfersUsed     Int                 @default(0)  // Transfers used
  contractTier      String?             // "basic", "premium", "enterprise", etc.
  contractStartDate DateTime?           // When contract started
  contractEndDate   DateTime?           // When contract expires
  
  // Application/approval tracking
  applicationStatus String              @default("pending") // "pending", "approved", "rejected"
  appliedAt         DateTime?           // When they applied
  approvedAt        DateTime?           // When approved by admin
  approvedBy        String?             @db.Uuid // Admin who approved
  rejectionReason   String?             // Why rejected (if applicable)
  
  brandAdmins       BrandAdmin[]
  prototypes        Prototype[]
  claimedProducts   CommunityProduct[]  @relation("BrandClaimedProducts")
  transfers         OwnershipTransfer[]

  @@index([name])
  @@index([verified])
  @@index([type])
  @@index([applicationStatus])
}

model BrandAdmin {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @db.Uuid
  brandId   String   @db.Uuid
  role      String   @default("admin") // "admin", "owner", "manager"
  createdAt DateTime @default(now())
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, brandId])
  @@index([userId])
  @@index([brandId])
}

model Prototype {
  id           String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name         String
  description  String?
  brandId      String      @db.Uuid
  sku          String?     @unique
  upc          String?
  category     String?
  retailPrice  Decimal?    @db.Decimal(10, 2)
  imageUrl     String?     // Official brand photo
  thumbnailUrl String?     // Official thumbnail
  variants     Json?       // Size, color options, etc.
  
  // Verification info
  isVerified   Boolean     @default(true)  // All prototypes are verified by definition
  verifiedAt   DateTime    @default(now())
  verifiedBy   String?     @db.Uuid        // BrandAdmin who created it
  
  // Status
  isActive     Boolean     @default(true)
  
  // Migration tracking (if converted from CommunityProduct)
  migratedFromCommunityProductId String? @db.Uuid
  
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt
  
  brand        Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  ownerships   Ownership[]
  transfers    OwnershipTransfer[]

  @@index([brandId])
  @@index([sku])
  @@index([upc])
  @@index([category])
  @@index([isActive])
  @@index([name]) // For search
}

model CommunityProduct {
  id                    String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                  String
  brandName             String                 // Text field, not linked to Brand
  description           String?
  upc                   String?
  category              String?
  imageUrl              String?                // User-uploaded photo
  thumbnailUrl          String?
  
  // Creator info
  createdBy             String                 @db.Uuid
  
  // Status tracking
  status                CommunityProductStatus @default(ACTIVE)
  
  // Brand claim tracking
  claimedByBrandId      String?                @db.Uuid
  claimedAt             DateTime?
  brandNotified         Boolean                @default(false) // Has matching brand been notified?
  
  // Migration tracking
  migratedToPrototypeId String?                @db.Uuid
  
  // Stats
  ownershipCount        Int                    @default(0)
  flagCount             Int                    @default(0)
  
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @default(now()) @updatedAt
  
  creator               User                   @relation("CommunityProductCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  claimedByBrand        Brand?                 @relation("BrandClaimedProducts", fields: [claimedByBrandId], references: [id])
  ownerships            Ownership[]

  @@index([brandName])
  @@index([upc])
  @@index([status])
  @@index([createdBy])
  @@index([claimedByBrandId])
  @@index([name]) // For search
}

model Ownership {
  id                 String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ownerId            String            @db.Uuid
  
  // Product relationship (ONE of these should be set)
  prototypeId        String?           @db.Uuid
  communityProductId String?           @db.Uuid
  
  // Verification status
  verified           Boolean           @default(false) // true = brand-transferred, false = user-claimed
  verifiedBy         String?           @db.Uuid        // BrandAdmin who verified/transferred
  verifiedAt         DateTime?         // When verified
  verificationCode   String?           @unique         // Unique code for verified ownerships
  
  // Transfer tracking
  transferId         String?           @db.Uuid        // Link to OwnershipTransfer if brand-transferred
  
  // Ownership status
  status             String            @default("owned") // "owned", "sold", "gifted", "lost"
  
  // Item condition & details
  condition          String?           // "new", "like-new", "good", "fair", "poor"
  notes              String?
  purchaseDate       DateTime?
  purchasePrice      Decimal?          @db.Decimal(10, 2)
  selectedVariant    Json?             // Which variant they own (size, color, etc.)
  serialNumber       String?           @unique
  
  // Authentication
  isAuthenticated    Boolean           @default(false)
  
  // Images - IMPORTANT CHANGE
  useOfficialImage   Boolean           @default(true)  // true = use prototype/community image, false = use own
  originalImageUrl   String?           // User's own photo of their item
  processedImageUrl  String?           // Processed version of user's photo
  thumbnailUrl       String?           // Thumbnail of user's photo
  processingStatus   String            @default("completed") // "pending", "processing", "completed", "failed"
  
  // Ownership chain (for transfers)
  ownershipChain     Json?
  transferable       Boolean           @default(false)
  
  // Flag tracking (if brand flags as fake)
  flagged            Boolean           @default(false)
  flagReason         String?
  flaggedBy          String?           @db.Uuid
  flaggedAt          DateTime?
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt
  
  owner              User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  prototype          Prototype?        @relation(fields: [prototypeId], references: [id])
  communityProduct   CommunityProduct? @relation(fields: [communityProductId], references: [id])
  transfer           OwnershipTransfer? @relation(fields: [transferId], references: [id])
  
  closetItems        ClosetItem[]
  matchItems         MatchItem[]
  memoryItems        MemoryItem[]

  @@unique([ownerId, prototypeId, serialNumber])
  @@index([ownerId])
  @@index([prototypeId])
  @@index([communityProductId])
  @@index([serialNumber])
  @@index([status])
  @@index([processingStatus])
  @@index([verified])
  @@index([flagged])
}

// NEW: Track brand transfers (contract-based quota system)
model OwnershipTransfer {
  id              String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  brandId         String     @db.Uuid
  prototypeId     String     @db.Uuid
  recipientId     String     @db.Uuid   // User receiving the ownership
  
  // Transfer details
  transferredBy   String     @db.Uuid   // BrandAdmin who made the transfer
  transferredAt   DateTime   @default(now())
  
  // Optional transfer info
  verificationCode String    @unique    // Unique code generated for this transfer
  purchaseOrderId  String?              // Optional PO/order reference
  notes            String?              // Optional notes from brand
  
  // Status
  status          String     @default("completed") // "pending", "completed", "cancelled"
  
  brand           Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  prototype       Prototype  @relation(fields: [prototypeId], references: [id], onDelete: Cascade)
  recipient       User       @relation("TransferReceiver", fields: [recipientId], references: [id], onDelete: Cascade)
  ownerships      Ownership[] // One transfer can create one ownership (1:1 relationship in practice)

  @@index([brandId])
  @@index([prototypeId])
  @@index([recipientId])
  @@index([transferredAt])
  @@index([status])
}

// Memories - Main social content (replaces Posts)
model Memory {
  id           String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId       String       @db.Uuid
  
  // Content
  title        String?
  caption      String?      // Main description/caption
  mediaUrl     String       // Photo or video URL
  mediaType    String       // "photo" or "video"
  thumbnailUrl String?
  
  // Date/location
  takenAt      DateTime?    // When photo/video was taken
  location     String?      // Optional location
  
  // Social engagement
  likesCount   Int          @default(0)
  commentsCount Int         @default(0)
  
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt
  
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        MemoryItem[] // Link to ownerships (outfit items)
  likes        Like[]       // Who liked this memory
  comments     Comment[]    // Comments on this memory

  @@index([userId])
  @@index([createdAt])
  @@index([mediaType])
}

// NEW: Link memories to ownerships (many-to-many)
model MemoryItem {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  memoryId    String    @db.Uuid
  ownershipId String    @db.Uuid
  
  memory      Memory    @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  ownership   Ownership @relation(fields: [ownershipId], references: [id], onDelete: Cascade)

  @@unique([memoryId, ownershipId])
  @@index([memoryId])
  @@index([ownershipId])
}

model Closet {
  name      String
  createdAt DateTime     @default(now())
  id        String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ownerId   String       @db.Uuid
  updatedAt DateTime     @default(now()) @updatedAt
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items     ClosetItem[]

  @@index([ownerId])
}

model ClosetItem {
  createdAt   DateTime  @default(now())
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  closetId    String    @db.Uuid
  ownershipId String    @db.Uuid
  closet      Closet    @relation(fields: [closetId], references: [id], onDelete: Cascade)
  ownership   Ownership @relation(fields: [ownershipId], references: [id], onDelete: Cascade)

  @@unique([closetId, ownershipId])
  @@index([closetId])
  @@index([ownershipId])
}

model Like {
  createdAt DateTime @default(now())
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  memoryId  String   @db.Uuid
  userId    String   @db.Uuid
  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([memoryId, userId])
  @@index([memoryId])
  @@index([userId])
}

model Comment {
  content   String
  createdAt DateTime @default(now())
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  memoryId  String   @db.Uuid
  userId    String   @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt
  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@index([userId])
}

model Match {
  title     String?
  createdAt DateTime    @default(now())
  id        String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String      @db.Uuid
  updatedAt DateTime    @default(now()) @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     MatchItem[]

  @@index([userId])
}

model MatchItem {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  matchId     String    @db.Uuid
  ownershipId String    @db.Uuid
  match       Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  ownership   Ownership @relation(fields: [ownershipId], references: [id], onDelete: Cascade)

  @@unique([matchId, ownershipId])
  @@index([matchId])
  @@index([ownershipId])
}

enum BrandType {
  INTERNATIONAL
  LOCAL
  TAILORED
}

enum CommunityProductStatus {
  ACTIVE
  UNDER_REVIEW
  MIGRATED
  DELETED
  FLAGGED
}
