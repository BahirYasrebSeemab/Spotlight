{
  "expo": {
    "name": "Spotlight",
    "slug": "spotlight",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/images/android-icon-foreground.png",

    "scheme": "spotlight",

    "linking": {
      "prefixes": ["spotlight://"],
      "config": {
        "screens": {
          "(auth)": {
            "screens": {
              "reset-password": "reset-password",
              "verify-email": "verify-email",
              "forget-password": "forget-password",
              "signup": "signup",
              "index": ""
            }
          },
          "(tabs)": "*",
          "modal": "modal"
        }
      }
    },

    "userInterfaceStyle": "automatic",

    "splash": {
      "image": "./assets/images/android-icon-foreground.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.teczer.expo-nativewind-typescript-boilerplate"
    },

    "android": {
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.teczer.exponativewindtypescriptboilerplate"
    },

    "web": {
      "bundler": "metro",
      "output": "single"
    },

    "plugins": ["expo-router", "expo-font", "expo-web-browser", "expo-sqlite"],

    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": true, 
      "optimizedImage": true,
      "router": {
        "server": false
      }
    }
  }
}
