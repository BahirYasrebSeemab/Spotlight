{
  "expo": {
    "name": "Spotlight",
    "slug": "spotlight",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/android-icon-foreground.png",
    "scheme": "spotlight",
    "newArchEnabled": true,
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/android-icon-foreground.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yasreb.spotlight",
      "associatedDomains": ["applinks:spotlight-web.expo.app"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.yasreb.spotlight",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "spotlight-web.expo.app",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-sqlite",
      "expo-secure-store",
      {
        "configureAndroidBackup": true,
        "faceIDPermission": "Allow $(PRODUCT_NAME) to access your Face ID biometric data."
      },
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": true,
      "optimizedImage": true,
      "router": {
        "server": false
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "845f1094-0a33-4d67-93d1-be902e2bd479"
      }
    },
    "owner": "yasreb"
  }
}
