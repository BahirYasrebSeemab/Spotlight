{
  "expo": {
    "name": "Spotlight",
    "slug": "spotlight",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/images/icon.png",

    "scheme": "spotlight",

    "linking": {
      "prefixes": ["spotlight://", "exp://192.168.150.17:8081"],
      "config": {
        "screens": {
          "(auth)": {
            "screens": {
              "reset-password": "reset-password",
              "verify-email": "verify-email",
              "forget-password": "forget-password",
              "signup": "signup",
              "index": ""
            }
          },
          "(tabs)": "*",
          "modal": "modal"
        }
      }
    },

    "userInterfaceStyle": "automatic",

    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.teczer.expo-nativewind-typescript-boilerplate"
    },

    "android": {
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.teczer.exponativewindtypescriptboilerplate"
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": ["expo-router", "expo-font", "expo-web-browser", "expo-sqlite"],

    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    }
  }
}
